{
    "name": "openbot",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.22.0",
    "engines": {
        "node": ">=22.19.0 <23",
        "pnpm": "11.22.0"
    },
    "scripts": {
        "dev": "corepack pnpm --filter @openbot/control-plane dev",
        "build": "tsc -b --pretty false && node scripts/workers.mjs dry-run && node scripts/d1-probe-workers.mjs",
        "typecheck": "tsc -b --pretty false",
        "test": "vitest run --config vitest.config.ts",
        "test:app:e2e": "playwright test --config playwright.config.ts",
        "test:d1-probes": "corepack pnpm --dir packages/d1-probes test",
        "test:base-layer:e2e": "corepack pnpm --dir packages/d1-probe-operator test:base-layer:e2e",
        "bench:base-layer": "corepack pnpm --dir packages/d1-probe-operator bench:base-layer",
        "bench:base-layer:reviewed": "node scripts/run-base-layer-benchmarks.mjs",
        "test:integration": "vitest run --config vitest.workers.config.ts && vitest run --config vitest.sandbox.workers.config.ts && vitest run --config vitest.d1-probe-writer.config.ts && corepack pnpm test:d1-probes",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "cf-typegen": "node scripts/workers.mjs typegen",
        "check:dependencies": "node scripts/check-dependencies.mjs && node scripts/run-base-layer-benchmarks.mjs --self-test && node scripts/check-app-e2e.mjs",
        "check:secrets": "node scripts/check-secrets.mjs",
        "check:fixtures": "node scripts/check-fixtures.mjs && node scripts/check-d1-probe-fixture.mjs && node scripts/check-cloudflare-worker-api-canary.mjs",
        "gate:attest:d1": "corepack pnpm --dir packages/gate-signer attest",
        "d1-probe:plan": "corepack pnpm --dir packages/d1-probe-operator plan",
        "d1-probe:plan-worker-api-canary": "corepack pnpm --dir packages/d1-probe-operator plan-worker-api-canary",
        "d1-probe:inspect-worker-api-canary-recovery": "corepack pnpm --dir packages/d1-probe-operator inspect-worker-api-canary-recovery",
        "d1-probe:check-route": "corepack pnpm --dir packages/d1-probe-operator check-route",
        "d1-probe:build-local": "node scripts/d1-probe-workers.mjs",
        "db:generate:d1": "drizzle-kit generate --config packages/db-d1/drizzle.config.ts",
        "db:migrate:d1:local": "wrangler d1 migrations apply CONTROL_DB_FRESH --local --config apps/control-plane/wrangler.d1.jsonc --env preview",
        "db:migrate:d1:remote": "wrangler d1 migrations apply CONTROL_DB_FRESH --remote --config apps/control-plane/wrangler.d1.jsonc --env production",
        "deploy:d1:preview": "node scripts/workers.mjs deploy preview",
        "deploy:d1:production": "node scripts/workers.mjs deploy production",
        "tail:preview": "wrangler tail --config apps/control-plane/wrangler.d1.jsonc --env preview",
        "tail:production": "wrangler tail --config apps/control-plane/wrangler.d1.jsonc --env production",
        "verify": "corepack pnpm format:check && corepack pnpm check:dependencies && corepack pnpm check:secrets && corepack pnpm check:fixtures && corepack pnpm typecheck && corepack pnpm test && corepack pnpm test:base-layer:e2e && corepack pnpm build",
        "verify:integration": "corepack pnpm verify && corepack pnpm test:integration && corepack pnpm test:app:e2e",
        "verify:preview": "node scripts/verify-preview.mjs"
    },
    "devDependencies": {
        "@openbot/gate-attestation": "workspace:*",
        "@cloudflare/vitest-plugin": "catalog:",
        "@cloudflare/workers-types": "catalog:",
        "@playwright/test": "catalog:",
        "@types/node": "catalog:",
        "drizzle-kit": "catalog:",
        "prettier": "catalog:",
        "tsx": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:",
        "wrangler": "catalog:"
    }
}
