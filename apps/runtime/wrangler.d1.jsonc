{
    "$schema": "../../node_modules/wrangler/config-schema.json",
    "name": "openbot-runtime",
    "main": "entry.d1.ts",
    "compatibility_date": "2026-08-22",
    "preview_urls": false,
    "workers_dev": false,
    "observability": { "enabled": false },
    "durable_objects": {
        "bindings": [
            {
                "name": "RUN_OBJECT",
                "class_name": "RunObject",
            },
        ],
    },
    "migrations": [
        {
            "tag": "v1",
            "new_sqlite_classes": ["RunObject"],
        },
    ],
    "env": {
        "preview": {
            "durable_objects": {
                "bindings": [
                    {
                        "name": "RUN_OBJECT",
                        "class_name": "RunObject",
                    },
                ],
            },
            "services": [
                {
                    "binding": "CAPABILITY_GATEWAY",
                    "service": "openbot-capability-gateway-preview",
                },
            ],
        },
        "production": {
            "durable_objects": {
                "bindings": [
                    {
                        "name": "RUN_OBJECT",
                        "class_name": "RunObject",
                    },
                ],
            },
            "services": [
                {
                    "binding": "CAPABILITY_GATEWAY",
                    "service": "openbot-capability-gateway-production",
                },
            ],
        },
    },
}
