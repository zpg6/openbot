{
    "$schema": "../../node_modules/wrangler/config-schema.json",
    "name": "openbot-control-plane",
    "main": "entry.d1.ts",
    "compatibility_date": "2026-08-22",
    "compatibility_flags": ["nodejs_compat"],
    "preview_urls": false,
    "workers_dev": false,
    "observability": { "enabled": false },
    "assets": {
        "binding": "ASSETS",
        "directory": "../../.build/client/control-plane",
    },
    "env": {
        "preview": {
            "d1_databases": [
                {
                    "binding": "CONTROL_DB_FRESH",
                    "database_name": "openbot-control-preview",
                    "database_id": "REPLACE_WITH_PREVIEW_D1_DATABASE_ID",
                    "migrations_dir": "../../packages/db-d1/migrations",
                },
            ],
            "services": [
                {
                    "binding": "ORCHESTRATOR",
                    "service": "openbot-orchestrator-preview",
                },
            ],
        },
        "production": {
            "d1_databases": [
                {
                    "binding": "CONTROL_DB_FRESH",
                    "database_name": "openbot-control-production",
                    "database_id": "REPLACE_WITH_PRODUCTION_D1_DATABASE_ID",
                    "migrations_dir": "../../packages/db-d1/migrations",
                },
            ],
            "services": [
                {
                    "binding": "ORCHESTRATOR",
                    "service": "openbot-orchestrator-production",
                },
            ],
        },
    },
}
