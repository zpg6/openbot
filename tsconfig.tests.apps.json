{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "composite": true,
        "jsx": "react-jsx",
        "lib": ["ES2024", "WebWorker", "DOM", "DOM.Iterable"],
        "outDir": "./.build/types/tests/apps",
        "resolveJsonModule": true,
        "rootDir": ".",
        "types": ["node", "vitest", "@cloudflare/workers-types"]
    },
    "include": ["apps/*/src/**/*.ts", "apps/*/src/**/*.tsx", "apps/*/src/**/*.json", "apps/*/tests/**/*.ts"],
    "references": [
        { "path": "./packages/db-d1" },
        { "path": "./packages/d1-probe-rpc" },
        { "path": "./packages/sandbox-protocol" }
    ]
}
